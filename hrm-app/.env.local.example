# HRM v1.1 환경변수 템플릿 — `.env.local`에 복사 후 실 값으로 채우기.
# .env.local 자체는 git 커밋 금지.

# ============================
# Supabase (필수)
# ============================
# Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# 같은 화면 > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 같은 화면 > service_role (⚠️ 절대 클라이언트 노출 금지, 서버 사이드만)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================
# 이메일 (직원 초대 전용 — 미설정 시 hrm_notifications에 stubbed로 기록만)
# ============================
# resend.com에서 발급. Supabase Auth invite와 별개로 자체 안내 메일을 보낼 때만 사용.
RESEND_API_KEY=re_...

# 도메인 검증 후 발신 주소 (예: HRM <noreply@your-company.com>)
RESEND_FROM_EMAIL=HRM <noreply@your-company.com>

# ============================
# SMS — 네이버 클라우드 SENS (선택 — 미설정 시 hrm_notifications에 stubbed로 기록만)
# ============================
# https://console.ncloud.com → Simple & Easy Notification Service에서 발급.
# 발송 대상: 직원이 sms_opt_in=true로 설정한 경우의 휴가 결재 요청/승인/반려 알림.
NCP_SENS_SERVICE_ID=ncp:sms:kr:...
NCP_SENS_ACCESS_KEY=...
NCP_SENS_SECRET_KEY=...

# 발신 번호 (사전 등록 필요, '-' 없이 또는 있이 입력)
NCP_SENS_FROM_NUMBER=02-1234-5678

# ============================
# 앱 메타
# ============================
# 이메일 본문 내 링크에 사용. 운영은 https://hrm.your-company.com 같은 형태.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron 호출 인증. 임의의 강한 문자열을 생성해 등록.
# 예: openssl rand -hex 32
CRON_SECRET=replace-me-with-strong-random-secret
